{
  "buildCommand": "echo Static deployment - no build required",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/موقع الطلاب",
      "destination": "/موقع الطلاب/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/portal.css",
      "destination": "/موقع الطلاب/portal.css"
    },
    {
      "source": "/portal.js",
      "destination": "/موقع الطلاب/portal.js"
    },
    {
      "source": "/admin.css",
      "destination": "/موقع الطلاب/admin.css"
    },
    {
      "source": "/admin.js",
      "destination": "/موقع الطلاب/admin.js"
    }
  ]
}
